{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gwl://schema/blc-curve-export-v1.9",
  "title": "GWL to BLC read-only curve export 1.9",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "manifestVersion", "curves", "integrity"],
  "properties": {
    "format": { "const": "gwl-blc-curve-export-v1" },
    "version": { "const": "1.9" },
    "manifestVersion": { "type": "string" },
    "curves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["curveId", "boundaryId", "itemId", "seriesId", "source", "domainType", "domainId", "domainLabel", "curveRole", "label", "metric", "unit", "geography", "dataNature", "worseningDirection", "observationCoverage", "observationSourceRefs", "thresholdAssessments", "observations", "displayObservations", "historicalReconstruction", "displayHistoricalReconstruction", "projections", "displayProjections", "displayDerivation", "methodBreaks", "sources"],
        "properties": {
          "curveId": { "type": "string" },
          "boundaryId": { "type": "string" },
          "itemId": { "type": "string" },
          "seriesId": { "type": "string" },
          "source": { "type": "string", "pattern": "^data/knowledge/" },
          "domainType": { "enum": ["planetary_boundary", "influence_area"] },
          "domainId": { "enum": ["climate_change", "biosphere_integrity", "freshwater_change", "land_system_change", "nutrient_cycles", "ocean_acidification", "atmospheric_aerosol_loading", "stratospheric_ozone_depletion", "novel_entities", "eah_material_energy_flows", "eah_tech_social_environment"] },
          "domainLabel": { "type": "string", "minLength": 1 },
          "curveRole": { "enum": ["core", "deep_dive"] },
          "label": { "type": "string" },
          "metric": { "type": "string" },
          "unit": { "type": "string" },
          "geography": { "type": "string" },
          "dataNature": { "enum": ["observed", "assessed_model_estimate"] },
          "worseningDirection": { "enum": ["increase", "decrease"] },
          "coverageExceptionRuleId": { "const": "blc_documented_single_year_coverage_exception" },
          "finding": { "type": "string" },
          "uncertainty": { "type": "string" },
          "methodNote": { "type": "string" },
          "contextNotes": {
            "type": "array",
            "items": { "$ref": "#/$defs/contextNote" }
          },
          "observationCoverage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startYear", "endYear", "spanYears", "pointCount"],
            "properties": {
              "startYear": { "type": "number" },
              "endYear": { "type": "number" },
              "spanYears": { "type": "number", "minimum": 0 },
              "pointCount": { "type": "integer", "minimum": 5 }
            }
          },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "qualifier", "exceedanceOperator", "value", "unit", "sourceRefs"],
            "properties": {
              "type": { "enum": ["planetary_boundaries_model", "scientific_reference"] },
              "modelName": { "type": "string" },
              "role": { "const": "boundary" },
              "qualifier": { "enum": ["exact", "approximate"] },
              "exceedanceOperator": { "enum": [">", "<"] },
              "value": { "type": "number" },
              "unit": { "type": "string" },
              "display": { "type": "string" },
              "sourceRefs": { "type": "array", "items": { "type": "string" } }
            }
          },
          "highRisk": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "unit", "exceedanceOperator"],
            "properties": {
              "value": { "type": "number" },
              "unit": { "type": "string" },
              "exceedanceOperator": { "enum": [">", "<"] },
              "sourceRefs": { "type": "array", "items": { "type": "string" } }
            }
          },
          "knownBoundaryCrossing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["year", "value", "unit"],
            "properties": {
              "year": { "type": "number" },
              "value": { "type": "number" },
              "unit": { "type": "string" },
              "sourceRefs": { "type": "array", "items": { "type": "string" } }
            }
          },
          "thresholdAssessments": {
            "type": "object",
            "additionalProperties": false,
            "required": ["boundary", "highRisk"],
            "properties": {
              "boundary": { "$ref": "#/$defs/thresholdAssessment" },
              "highRisk": { "$ref": "#/$defs/thresholdAssessment" }
            }
          },
          "observations": { "type": "array", "minItems": 5 },
          "displayObservations": { "type": "array", "minItems": 2 },
          "observationSourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "observationProvenance": { "$ref": "#/$defs/provenance" },
          "historicalReconstruction": { "type": "array" },
          "displayHistoricalReconstruction": { "type": "array" },
          "projections": { "type": "array" },
          "displayProjections": { "type": "array" },
          "displayDerivation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["interpolation", "transformations", "observations", "historicalReconstruction", "projections"],
            "properties": {
              "interpolation": { "const": false },
              "transformations": { "type": "array", "maxItems": 0 },
              "observations": { "$ref": "#/$defs/displaySelection" },
              "historicalReconstruction": { "$ref": "#/$defs/displaySelection" },
              "projections": { "$ref": "#/$defs/displaySelection" }
            }
          },
          "methodBreaks": { "type": "array" },
          "sources": { "type": "array" }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "scope", "hash"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "scope": { "type": "string" },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["year", "value"],
      "properties": { "year": { "type": "number" }, "value": { "type": "number" } }
    },
    "thresholdAssessment": {
      "type": "object",
      "required": ["thresholdValue", "thresholdUnit", "exceedanceOperator", "status"],
      "properties": {
        "thresholdValue": { "type": ["number", "null"] },
        "thresholdUnit": { "type": ["string", "null"] },
        "exceedanceOperator": { "enum": [">", "<", null] },
        "status": { "enum": ["crossed", "already_crossed_at_start", "not_crossed", "series_ends_before_known_crossing", "not_assessable"] },
        "reason": { "type": "string" },
        "firstCrossingPoint": { "$ref": "#/$defs/point" },
        "lastCheckedPoint": { "$ref": "#/$defs/point" },
        "knownCrossingPoint": { "$ref": "#/$defs/point" }
      }
    },
    "displaySelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputPointCount", "outputPointCount", "intervalYears", "rule"],
      "properties": {
        "inputPointCount": { "type": "integer", "minimum": 0 },
        "outputPointCount": { "type": "integer", "minimum": 0 },
        "intervalYears": { "type": "integer", "minimum": 1 },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "contextNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value", "detail", "sourceRefs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFile", "sourceUrl", "locator", "fields", "extraction", "transformation"],
      "properties": {
        "sourceFile": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "locator": { "type": "string", "minLength": 1 },
        "fields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "extraction": { "type": "string", "minLength": 1 },
        "transformation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
