{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gwl://schema/blc-curve-export-v1.4",
  "title": "GWL to BLC read-only curve export 1.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "manifestVersion", "curves", "integrity"],
  "properties": {
    "format": { "const": "gwl-blc-curve-export-v1" },
    "version": { "const": "1.4" },
    "manifestVersion": { "type": "string" },
    "curves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["curveId", "boundaryId", "itemId", "seriesId", "source", "domainType", "domainId", "domainLabel", "curveRole", "label", "metric", "unit", "geography", "worseningDirection", "observationCoverage", "observationSourceRefs", "observations", "historicalReconstruction", "projections", "methodBreaks", "sources"],
        "properties": {
          "curveId": { "type": "string" },
          "boundaryId": { "type": "string" },
          "itemId": { "type": "string" },
          "seriesId": { "type": "string" },
          "source": { "type": "string", "pattern": "^data/knowledge/" },
          "domainType": { "enum": ["planetary_boundary", "influence_area"] },
          "domainId": { "enum": ["climate_change", "biosphere_integrity", "freshwater_change", "land_system_change", "nutrient_cycles", "ocean_acidification", "atmospheric_aerosol_loading", "stratospheric_ozone_depletion", "novel_entities", "eah_material_energy_flows", "eah_tech_social_environment"] },
          "domainLabel": { "type": "string", "minLength": 1 },
          "curveRole": { "enum": ["core", "deep_dive"] },
          "label": { "type": "string" },
          "metric": { "type": "string" },
          "unit": { "type": "string" },
          "geography": { "type": "string" },
          "worseningDirection": { "enum": ["increase", "decrease"] },
          "observationCoverage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startYear", "endYear", "spanYears", "pointCount"],
            "properties": {
              "startYear": { "type": "number" },
              "endYear": { "type": "number" },
              "spanYears": { "type": "number", "minimum": 50 },
              "pointCount": { "type": "integer", "minimum": 5 }
            }
          },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["planetary_boundaries_model", "scientific_reference"] },
              "modelName": { "type": "string" },
              "role": { "const": "boundary" },
              "qualifier": { "enum": ["exact", "approximate"] },
              "exceedanceOperator": { "enum": [">", "<"] },
              "value": { "type": "number" },
              "unit": { "type": "string" },
              "display": { "type": "string" },
              "sourceRefs": { "type": "array", "items": { "type": "string" } }
            }
          },
          "observations": { "type": "array", "minItems": 5 },
          "observationSourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "historicalReconstruction": { "type": "array" },
          "projections": { "type": "array" },
          "methodBreaks": { "type": "array" },
          "sources": { "type": "array" }
        },
        "allOf": [
          {
            "if": {
              "required": ["seriesId"],
              "properties": { "seriesId": { "const": "biosphere_hanpp_1910_2020" } }
            },
            "then": {
              "required": ["reference"],
              "properties": {
                "reference": {
                  "required": ["role", "qualifier", "exceedanceOperator", "value", "unit", "sourceRefs"]
                }
              }
            }
          }
        ]
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "scope", "hash"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "scope": { "type": "string" },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
