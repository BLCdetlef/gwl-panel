  "planetaryBoundaryContext": {
    "primaryBoundary": "Neue Substanzen",
    "status": "überschritten",
    "interpretation": "Die Grenze Neue Substanzen wird auf Systemebene als überschritten bewertet, weil Produktion und Freisetzung schneller wachsen als globale Bewertungs- und Überwachungskapazitäten. PFAS sind ein prominentes Beispiel, aber nicht die Kontrollgröße der Grenze.",
    "sourceRefs": [
      "src_persson_2022"
    ]
  },
  "healthContext": {
    "efsaCriticalEffect": "verminderte Immunantwort auf Impfungen",
    "who2026PriorityCategories": [
      "kardiometabolisch",
      "hepatisch",
      "immunologisch",
      "Entwicklung",
      "Reproduktion",
      "Krebs"
    ],
    "note": "WHO bewertet 2026 die Evidenz für 18 priorisierte PFAS und sechs Gesundheitskategorien weiter. Nicht jede PFAS-Substanz hat denselben Evidenzstand."
  },
