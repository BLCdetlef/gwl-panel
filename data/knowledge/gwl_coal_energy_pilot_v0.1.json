      "evidenceStatus": "strong"
    },
    {
      "id": "coal_to_aerosols",
      "boundaries": [
        "Stoff- und Energieströme",
        "Atmosphärische Aerosole"
      ],
      "mechanism": "Kohleverbrennung emittiert Schwefelverbindungen, Partikel und weitere Luftschadstoffe. Die planetare Aerosolwirkung ist jedoch regional und atmosphärisch komplex.",
      "evidenceStatus": "moderate"
    },
    {
      "id": "coal_to_freshwater",
      "boundaries": [
        "Stoff- und Energieströme",
        "Süßwasser"
      ],
      "mechanism": "Bergbau, Aufbereitung und Kraftwerksbetrieb können lokal Wasser entnehmen und Gewässer belasten; ein einheitlicher globaler Wirkungswert wird nicht behauptet.",
      "evidenceStatus": "moderate"
    },
    {
      "id": "coal_to_land",
